rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /societies/{societyId} {
      // Society name/code login runs before Firebase user authentication.
      // Keep this document readable for the bootstrap login; tenant data below remains protected.
      allow read: if true;
      allow write: if isAdminOfSociety(societyId);

      match /persons/{personId} {
        allow read: if userHasAccessToSociety(societyId);
        allow write: if isGuardOrAdminOfSociety(societyId);
        allow delete: if isAdminOfSociety(societyId);
      }

      match /entries/{entryId} {
        allow read: if userHasAccessToSociety(societyId);
        allow write: if isGuardOrAdminOfSociety(societyId);
        allow delete: if isAdminOfSociety(societyId);
      }

      match /vehicles/{vehicleId} {
        allow read: if userHasAccessToSociety(societyId);
        allow write: if isGuardOrAdminOfSociety(societyId);
      }

      match /auditLogs/{logId} {
        allow read: if userHasAccessToSociety(societyId);
        allow write: if false;
      }
    }

    match /subscriptions/{subscriptionId} {
      allow read, write: if isSubscriptionOwner(subscriptionId);
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function userHasAccessToSociety(societyId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.societies[societyId] != null;
    }

    function isGuardOrAdminOfSociety(societyId) {
      return userHasAccessToSociety(societyId) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.societies[societyId] == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.societies[societyId] == 'guard');
    }

    function isAdminOfSociety(societyId) {
      return userHasAccessToSociety(societyId) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.societies[societyId] == 'admin';
    }

    function isSubscriptionOwner(subscriptionId) {
      return request.auth != null &&
        get(/databases/$(database)/documents/subscriptions/$(subscriptionId)).data.userId == request.auth.uid;
    }
  }
}
